# Required for useful connection links: public DNS name or public VPS IP.
DOMAIN=your-server.example.com
PANEL_PATH=knight
PORT=8080
TLS_PORT=443

# Optional: set an 8+ character password before deployment. Leave empty to use
# first-time setup, secured by /data/setup-key.txt (see README).
PANEL_PASSWORD=
# Optional stable identities. Blank values are generated and persisted in /data.
UUID=
SUB_TOKEN=
SETUP_KEY=

# Native engine listeners and shared-port protocols.
ENABLE_VLESS_WS=true
ENABLE_VLESS_WS_TLS=true
ENABLE_VMESS_WS=true
ENABLE_VMESS_WS_TLS=true
ENABLE_TROJAN_WS=true
ENABLE_TROJAN_WS_TLS=true
ENABLE_HTTPUPGRADE=true
ENABLE_VMESS_HTTPUPGRADE=true
ENABLE_TROJAN_HTTPUPGRADE=true
ENABLE_VLESS_GRPC=true
ENABLE_VLESS_GRPC_TLS=true
ENABLE_TROJAN_GRPC_TLS=true
ENABLE_XHTTP=true
ENABLE_SS_WS=true
ENABLE_REALITY=true
REALITY_TARGET=www.google.com
REALITY_TARGET_PORT=443
REALITY_SHORT_ID=
ENABLE_SHADOWTLS_VLESS=false
# Must differ from REALITY_TARGET if both enabled.
SHADOWTLS_SNI=www.apple.com
SHADOWTLS_PASSWORD=

ENABLE_SS=true
SS_METHOD=aes-256-gcm
SS_PASSWORD=
SS_PORT=8388
ENABLE_WIREGUARD=true
WG_PORT=51820
WG_SERVER_IP=10.66.66.1/24
WG_CLIENT_IP=10.66.66.2/32
WG_MTU=1420
ENABLE_HYSTERIA2=false
HY2_PORT=8443
ENABLE_TUIC=false
TUIC_PORT=8444
TUIC_CC=bbr

# SOCKS5 and HTTP CONNECT use this server's PORT and always require credentials.
ENABLE_SOCKS=false
SOCKS_USER=knight
SOCKS_PASSWORD=
ENABLE_HTTP_PROXY=false
HTTP_PROXY_USER=knight
HTTP_PROXY_PASSWORD=
# Empty proxy passwords use the persisted UUID.

# TLS: without these, a self-signed certificate is generated and exported
# TLS client profiles explicitly allow it. Use trusted PEM certificates in production.
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem
# LINK_INSECURE=false
# LINK_SNI=your-server.example.com
# LINK_HOST=your-server.example.com
LINK_FP=chrome
# Optional override for subscription URLs only (not proxy destination ports):
PUBLIC_BASE_URL=
TRAFFIC_LIMIT_GB=0
LOCATION=VPS / Docker

# Optional Cloudflare quick tunnel; persistent named tunnel needs both values.
ENABLE_ARGO=false
ARGO_DOMAIN=
ARGO_AUTH=
# For a named tunnel, configure its public hostname in Cloudflare to route to
# http://localhost:8080 (or http://127.0.0.1:8080). ARGO_AUTH is its tunnel token.

# Native install directory outside Docker; Docker always persists /data.
# BK_DATA_DIR=/var/lib/blue-knight
# Optional preinstalled binaries:
# SINGBOX_BIN=/usr/local/bin/sing-box
# XRAY_BIN=/usr/local/bin/xray
# CLOUDFLARED_BIN=/usr/local/bin/cloudflared
